---
---

<div class="rail-ctl" role="group" aria-label="外观">
  <button type="button" id="bg-toggle" class="rail-btn" title="切换背景壁纸" aria-label="切换背景壁纸">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <rect x="3" y="4" width="18" height="16" rx="2"></rect>
      <circle cx="9" cy="10" r="1.6"></circle>
      <path d="m21 16-5-5-8 8"></path>
    </svg>
  </button>
  <button
    type="button"
    id="fx-toggle"
    class="rail-btn"
    title="特效：背景材质（网格 / 扫描线 / 噪点）与标题字符扰动"
    aria-label="特效"
    aria-pressed="true"
  >
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M3 9h18M3 15h18M9 3v18M15 3v18"></path>
    </svg>
  </button>
  <button type="button" id="theme-toggle" class="rail-btn" title="切换深浅色" aria-label="切换深浅色">
    <svg class="sun" viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="12" cy="12" r="4"></circle>
      <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
    </svg>
    <svg class="moon" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
    </svg>
  </button>
</div>
<p class="rail-cap" aria-live="polite">
  <span id="bg-index">01 / 01</span>
  <span id="bg-name">—</span>
</p>
