---
---

<section class="player" id="player" aria-label="音乐播放器">
  <audio preload="metadata"></audio>
  <span class="pl-cover">
    <img alt="" width="36" height="36" />
  </span>
  <div class="pl-meta">
    <span class="pl-line">
      <b class="pl-title">—</b>
      <span class="pl-eq" aria-hidden="true">
        <i></i>
        <i></i>
        <i></i>
        <i></i>
      </span>
    </span>
    <small class="pl-artist"></small>
  </div>
  <p class="pl-lyric" aria-live="off"></p>
  <div class="pl-track">
    <span class="pl-cur mono-label">0:00</span>
    <div class="pl-bar" role="slider" aria-label="播放进度" aria-valuemin="0" aria-valuemax="100">
      <i class="pl-fill"></i>
    </div>
    <span class="pl-dur mono-label">0:00</span>
  </div>
  <div class="pl-ctl">
    <button type="button" class="pl-prev" aria-label="上一首">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M6 5v14M19 5 9 12l10 7z"></path>
      </svg>
    </button>
    <button type="button" class="pl-play" aria-label="播放">
      <svg class="i-play" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M7 4.5v15l12-7.5z"></path>
      </svg>
      <svg class="i-pause" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M8 5v14M16 5v14"></path>
      </svg>
    </button>
    <button type="button" class="pl-next" aria-label="下一首">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M18 5v14M5 5l10 7-10 7z"></path>
      </svg>
    </button>
    <button type="button" class="pl-mode" data-mode="list" title="列表循环" aria-label="播放模式：列表循环">
      <svg class="i-list" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M17 2l4 4-4 4"></path>
        <path d="M3 11V9a3 3 0 0 1 3-3h15"></path>
        <path d="M7 22l-4-4 4-4"></path>
        <path d="M21 13v2a3 3 0 0 1-3 3H3"></path>
      </svg>
      <svg class="i-shuffle" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M16 3h5v5"></path>
        <path d="M4 20 21 3"></path>
        <path d="M21 16v5h-5"></path>
        <path d="M15 15l6 6"></path>
        <path d="M4 4l5 5"></path>
      </svg>
      <svg class="i-single" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M17 2l4 4-4 4"></path>
        <path d="M3 11V9a3 3 0 0 1 3-3h15"></path>
        <path d="M7 22l-4-4 4-4"></path>
        <path d="M21 13v2a3 3 0 0 1-3 3H3"></path>
        <path d="M11 10h1v4"></path>
      </svg>
    </button>
    <span class="pl-volume">
      <button type="button" class="pl-mute" title="静音" aria-label="静音" aria-pressed="false">
        <svg class="i-vol" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 9h3l5-4v14l-5-4H4z"></path>
          <path d="M16 9a4 4 0 0 1 0 6"></path>
          <path d="M18.5 6.5a8 8 0 0 1 0 11"></path>
        </svg>
        <svg class="i-muted" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 9h3l5-4v14l-5-4H4z"></path>
          <path d="M16 9l5 6M21 9l-5 6"></path>
        </svg>
      </button>
      <input class="pl-vol pl-vol-top" type="range" min="0" max="1" step="0.01" value="0.7" aria-label="音量" />
    </span>
    <button
      type="button"
      class="pl-listbtn"
      aria-expanded="false"
      aria-controls="pl-panel"
      title="播放列表"
      aria-label="播放列表"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M8 6h13"></path>
        <path d="M8 12h13"></path>
        <path d="M8 18h13"></path>
        <path d="M3 6h.01"></path>
        <path d="M3 12h.01"></path>
        <path d="M3 18h.01"></path>
      </svg>
    </button>
    <button
      type="button"
      class="pl-expand"
      aria-expanded="false"
      aria-controls="player"
      title="展开播放器"
      aria-label="展开播放器"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="m6 15 6-6 6 6"></path>
      </svg>
    </button>
  </div>
</section>
