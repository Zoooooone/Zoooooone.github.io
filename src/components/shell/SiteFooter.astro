---
import { getCollection } from 'astro:content';
import { site } from '@/config';

const builtAt = new Date();
const stamp = `${builtAt.getFullYear()}${String(builtAt.getMonth() + 1).padStart(2, '0')}${String(builtAt.getDate()).padStart(2, '0')}`;
const serial = `ZB-${stamp}`;
const postCount = (await getCollection('posts')).length;

const barcode = (() => {
  const bars: { x: number; w: number }[] = [];
  let x = 0;
  for (let i = 0; i < serial.length * 4; i++) {
    const w = 1 + ((serial.charCodeAt(i % serial.length) + i * 7) % 3);
    if (i % 2 === 0) bars.push({ x, w });
    x += w;
  }
  return { bars, width: x };
})();
---

<footer class="sheet-foot" aria-hidden="true">
  <span>
    {serial} · {postCount} POSTS
  </span>
  <svg class="barcode" viewBox={`0 0 ${barcode.width} 14`} preserveAspectRatio="none" fill="currentColor">
    {barcode.bars.map((r) => (
      <rect x={r.x} y="0" width={r.w} height="14" />
    ))}
  </svg>
  <span>
    © {builtAt.getFullYear()} {site.author}
  </span>
</footer>
