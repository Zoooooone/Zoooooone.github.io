---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHead from '@/components/ui/PageHead.astro';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { icons } from '@/lib/icons';
import { siLeetcode } from 'simple-icons';
import { newestFirst, type Track } from '@/scripts/shell/player/playlist';

const tracks = newestFirst(
  JSON.parse(readFileSync(join(process.cwd(), 'public/assets/audio/playlist/playlist1.json'), 'utf8')) as Track[],
);

const playableTracks = tracks.filter((track) => track.url);

const panels = [
  {
    lang: 'zh',
    locale: 'zh-CN',
    about: '关于我',
    intro: [
      '我是 Zone，一个不太爱吃盐水鸭的南京人，现在在东京生活，是一名全栈 AI 工程师。',
      '一个 INFJ，喜欢可爱的东西，平时玩原神、听音乐，也看短跑和足球。',
      '这个博客放着不同阶段写下的东西。有些想法现在已经变了，有些喜欢的东西倒是一直没变。欢迎随便看看。',
    ],
    games: '游戏',
    gameGallery: '玩过的一些游戏',
    music: '音乐',
    videoHeading: '视频',
    backgroundDetails: '教育与工作经历',
    interests: [
      '原神玩得比较多，高难挑战、音乐、剧情和世界观都喜欢。打高难会花不少时间排轴、练操作，也会把满意的录像剪成视频。',
      '听了很多年的电子乐，最喜欢的电子音乐制作人是 Avicii。也听很多其他类型的音乐，原神 OST 的初级研究者，最近在系统整理曲目，找找不同曲子之间的联系。',
    ],
    playlist: '高频歌单',
    playlistHint: '点击即可在顶部播放器中播放，换页也不会中断。',
    pendingAudio: '音源待添加',
    videos: ['Avicii 纪念剪辑', '原神爬塔：1 限定金到 20 层', '短跑混剪', '死亡搁浅：场景与音乐'],
    sports: '看比赛',
    races: [
      '短跑主要看 100 米和 200 米，比赛之外也爱看技术分析、分段数据和选手人物志。北奥博尔特的 9.69 回头望月、东奥苏炳添的 9.83 一鸣惊人，是我最喜欢的两个瞬间。',
      '2012 年开始看足球，一直是曼联球迷。',
    ],
    background: '经历与联系',
    education: '教育',
    experience: '工作经历',
    present: '至今',
    school: '南京外国语学校',
    university: '东京大学',
    bachelor: '本科 · 机械情报工学',
    master: '硕士 · 智能机械情报学 · ISI Lab',
    engineer: '全栈 AI 工程师',
    assistant: '助教',
    intern: '数据分析实习',
  },
  {
    lang: 'en',
    locale: 'en',
    about: 'About me',
    intro: [
      "I'm Zone, a Nanjing native who isn't particularly fond of salted duck. I now live in Tokyo and work as a full-stack AI engineer.",
      'An INFJ who likes cute things. In my spare time, I play Genshin Impact, listen to music, and watch sprint races and football.',
      "This blog has things I've written at different points in my life. Some of my views have changed; some of the things I like haven't. Feel free to look around.",
    ],
    games: 'Games',
    gameGallery: "Some games I've played",
    music: 'Music',
    videoHeading: 'Videos',
    backgroundDetails: 'Education & work experience',
    interests: [
      "I play quite a bit of Genshin Impact and enjoy its combat challenges, music, story, and worldbuilding. For difficult challenges, I spend time planning rotations and practising execution, and sometimes edit recordings of runs I'm happy with into videos.",
      "I've listened to electronic music for years, and Avicii is my favourite electronic music producer. I listen to plenty of other genres too. I'm a beginner at exploring Genshin's OSTs, and lately I've been organising the tracks and looking for connections between them.",
    ],
    playlist: 'On repeat',
    playlistHint: 'Click a track to play it in the player at the top. Playback continues when you change pages.',
    pendingAudio: 'Audio coming soon',
    videos: [
      'Avicii tribute edit',
      'Genshin tower challenge: floor 20 with one limited 5-star',
      'Sprint montage',
      'Death Stranding: scenes and music',
    ],
    sports: 'Watching sports',
    races: [
      "For sprinting, I mainly follow the 100 m and 200 m. I also enjoy technique breakdowns, split-time analysis, and profiles of athletes. Bolt looking back during his 9.69 in Beijing and Su Bingtian's breakthrough 9.83 in Tokyo are my two favourite moments.",
      "I've watched football since 2012 and have been a Manchester United fan all along.",
    ],
    background: 'Background & contact',
    education: 'Education',
    experience: 'Work experience',
    present: 'Present',
    school: 'Nanjing Foreign Language School',
    university: 'The University of Tokyo',
    bachelor: 'Bachelor of Engineering · Mechano-Informatics',
    master: 'Master of Engineering · Mechano-Informatics · ISI Lab',
    engineer: 'Full-stack AI engineer',
    assistant: 'Teaching Assistant',
    intern: 'Data Analysis Intern',
  },
];
const videoIds = ['BV1d54y1Q7ts', 'BV1RdX9YUEK1', 'BV1ymeMekEs5', 'BV1REbtevEcC'];
const links = [
  { name: 'GitHub', href: 'https://github.com/Zoooooone', icon: 'github', zh: '代码', en: 'Code' },
  {
    name: 'LinkedIn',
    href: 'https://www.linkedin.com/in/ziheng-chen-572356285/',
    icon: 'linkedin',
    zh: '经历',
    en: 'Background',
  },
  { name: 'LeetCode', href: 'https://leetcode.com/Zoooooone', icon: '', zh: '刷题', en: 'Practice' },
];
---

<BaseLayout title="About">
  <PageHead label="ABOUT · 关于" title="About · 关于" meta="PROFILE" />

  <div class="lang-tabs" role="tablist" aria-label="Language">
    <button type="button" class="filter" data-lang="zh" aria-pressed="true">
      中文
    </button>
    <button type="button" class="filter" data-lang="en" aria-pressed="false">
      English
    </button>
  </div>

  {panels.map((p) => (
    <div class="prose about" data-panel={p.lang} lang={p.locale} hidden={p.lang === 'en'}>
      <h2>{p.about}</h2>
      {p.intro.map((paragraph) => (
        <p>{paragraph}</p>
      ))}

      <h2>{p.games}</h2>
      <p>{p.interests[0]}</p>
      <details class="about-details">
        <summary>{p.gameGallery}</summary>
        <div id={`about-games-${p.lang}`} class="gallery" data-src="/assets/src/about_me/games/info.json" />
      </details>

      <h2>{p.music}</h2>
      <p>{p.interests[1]}</p>
      <h3>{p.playlist}</h3>
      <p>{p.playlistHint}</p>
      <ol class="tracklist">
        {tracks.map((t, i) => (
          <li>
            <button type="button" data-track={t.url ? playableTracks.indexOf(t) : undefined} disabled={!t.url}>
              <span class="n">{String(i + 1).padStart(2, '0')}</span>
              <span class="nm">{t.name}</span>
              <span class="ar">{t.url ? t.artist : p.pendingAudio}</span>
            </button>
          </li>
        ))}
      </ol>
      <h2>{p.sports}</h2>
      {p.races.map((paragraph) => (
        <p>{paragraph}</p>
      ))}

      <h2>{p.videoHeading}</h2>
      {videoIds.map((id, i) => (
        <>
          <h3>{p.videos[i]}</h3>
          <iframe
            class="embed-video"
            title={p.videos[i]}
            src={`https://player.bilibili.com/player.html?bvid=${id}&autoplay=0`}
            allowfullscreen
            loading="lazy"
          />
        </>
      ))}

      <h2>{p.background}</h2>
      <details class="about-details">
        <summary>{p.backgroundDetails}</summary>
        <h3>{p.education}</h3>
        <ul class="cv">
          <li>
            <span class="when">2012.9 – 2018.6</span>
            <div>
              <a href="http://www.nfls.com.cn/" rel="noopener">
                {p.school}
              </a>
            </div>
          </li>
          <li>
            <span class="when">2019.4 – 2023.3</span>
            <div>
              <a href="https://www.u-tokyo.ac.jp/en/index.html" rel="noopener">
                {p.university}
              </a>
              <small>
                <a href="http://www.kikaib.t.u-tokyo.ac.jp/" rel="noopener">
                  {p.bachelor}
                </a>
              </small>
            </div>
          </li>
          <li>
            <span class="when">2023.4 – 2025.3</span>
            <div>
              <a href="https://www.u-tokyo.ac.jp/en/index.html" rel="noopener">
                {p.university}
              </a>
              <small>
                <a href="http://www.isi.imi.i.u-tokyo.ac.jp/?lang=en" rel="noopener">
                  {p.master}
                </a>
              </small>
            </div>
          </li>
        </ul>
        <h3>{p.experience}</h3>
        <ul class="cv">
          <li>
            <span class="when">2025.4 – {p.present}</span>
            <div>
              <a href="https://exawizards.com/" rel="noopener">
                ExaWizards Inc.
              </a>
              <small>{p.engineer}</small>
            </div>
          </li>
          <li>
            <span class="when">2023.4 – 2025.4</span>
            <div>
              <a href="https://www.u-tokyo.ac.jp/en/index.html" rel="noopener">
                {p.university}
              </a>
              <small>{p.assistant}</small>
            </div>
          </li>
          <li>
            <span class="when">2023.12</span>
            <div>
              <a href="https://www.ibm.com/jp-ja/about/subsidiaries/ise" rel="noopener">
                IBM Systems Engineering Co., Ltd.
              </a>
              <small>{p.intern}</small>
            </div>
          </li>
        </ul>
      </details>
      <ul class="link-list">
        {links.map((link) => (
          <li>
            <a href={link.href} rel="noopener" target="_blank">
              {link.icon ? (
                <svg viewBox="0 0 24 24" class="stroke" aria-hidden="true">
                  {(icons[link.icon] ?? []).map((path) => (
                    <path d={path} />
                  ))}
                </svg>
              ) : (
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d={siLeetcode.path} />
                </svg>
              )}
              <strong>{link.name}</strong>
              <span>{p.lang === 'zh' ? link.zh : link.en}</span>
            </a>
          </li>
        ))}
      </ul>
      <p>
        <a href="mailto:opitz4546@gmail.com">opitz4546@gmail.com</a>
      </p>
    </div>
  ))}
</BaseLayout>

<script>
  import '@/scripts/post';
  import '@/scripts/pages/about-lang';
</script>
