---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHead from '@/components/ui/PageHead.astro';
import IndexRows from '@/components/list/IndexRows.astro';
import { getPosts } from '@/lib/posts';

const posts = await getPosts();
posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const years: { year: number; items: typeof posts }[] = [];
for (const p of posts) {
  const y = p.data.date.getFullYear();
  const last = years.at(-1);
  if (last?.year === y) last.items.push(p);
  else years.push({ year: y, items: [p] });
}
---

<BaseLayout title="Archives">
  <PageHead
    label="ARCHIVES · 归档"
    title="归档"
    meta={`${posts.length} DOCUMENTS · ${years.length} YEARS`}
    mark={years.length}
  />

  {years.map((y) => (
    <section class="year-block">
      <div class="year-head">
        <h2>{y.year}</h2>
        <span class="mono-label">{y.items.length} DOCUMENTS</span>
      </div>
      <IndexRows posts={y.items} shortDate />
    </section>
  ))}
</BaseLayout>
