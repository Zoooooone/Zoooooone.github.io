---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHead from '@/components/ui/PageHead.astro';
import IndexRows from '@/components/list/IndexRows.astro';
import { getPosts, groupBy } from '@/lib/posts';

export async function getStaticPaths() {
  const groups = groupBy(await getPosts(), 'categories');
  return groups.map((g) => ({ params: { name: g.slug }, props: { group: g } }));
}

const { group } = Astro.props;
const posts = [...group.posts].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title={group.name}>
  <PageHead
    label="CATEGORY · 分类"
    title={group.name}
    meta={`${group.posts.length} DOCUMENTS`}
    mark={group.posts.length}
  />
  <IndexRows posts={posts} />
  <p class="back">
    <a href="/categories/">◂ 返回分类</a>
  </p>
</BaseLayout>
