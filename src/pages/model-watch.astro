---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHead from '@/components/ui/PageHead.astro';
import { analytics } from '@/config';
import { BOARD_LABELS } from '@/scripts/model-watch/metrics';
import { MEDIA_BOARDS } from '@/scripts/model-watch/types';

// Only the dev server reads the override (pnpm dev:mock), so a built site can never be pointed elsewhere.
const endpoint = (import.meta.env.DEV && import.meta.env.PUBLIC_STATS_ENDPOINT) || analytics.endpoint;

const ranges = [7, 30, 90];

const sections = [
  { id: 'mw-changes', label: '变化' },
  { id: 'mw-ranking', label: '排行' },
  { id: 'mw-charts', label: '图表' },
  { id: 'mw-arenas', label: '竞技场' },
];

const rankTabs = [
  { key: 'metric', label: '按指标' },
  { key: 'creator', label: '按厂商' },
];

const chartTabs = [
  { key: 'value', label: '智能与价格' },
  { key: 'speed', label: '智能与速度' },
  { key: 'frontier', label: '前沿演进' },
  { key: 'timeline', label: '发布时间线' },
];
---

<BaseLayout title="Model Watch" noindex>
  <PageHead label="MODEL WATCH · 模型观察" title="AI 模型动态" meta="PRIVATE · DAILY 06:00 TOKYO" />

  <div class="stats model-watch" data-model-watch data-endpoint={endpoint}>
    <form class="gate frame cut-s" data-gate hidden>
      <label class="mono-label" for="model-watch-token">
        ACCESS TOKEN · 口令
      </label>
      <input id="model-watch-token" name="token" type="password" autocomplete="current-password" required data-token />
      <p class="gate-error" role="alert" data-gate-error></p>
      <button class="go" type="submit">
        UNLOCK ▸
      </button>
    </form>

    <div class="board" data-dashboard hidden>
      <div class="toolbar">
        <label class="check">
          <input type="checkbox" data-merge checked />
          合并推理档位
        </label>
        <label class="check">
          <input type="checkbox" data-unlisted />
          包含没有价格的模型
        </label>
        <span class="grow"></span>
        <span class="mono-label" role="status" data-status></span>
        <button class="tool" type="button" data-refresh>
          刷新
        </button>
        <button class="tool" type="button" data-signout>
          退出
        </button>
      </div>
      <div class="warn" role="alert" data-warn></div>

      <div class="kpis" data-kpis></div>

      <nav class="anchors" aria-label="页面导航" data-anchors>
        {sections.map((section) => (
          <a href={`#${section.id}`} data-anchor={section.id}>
            {section.label}
          </a>
        ))}
      </nav>

      <section class="panel frame cut-s" id="mw-changes" data-section aria-label="变化">
        <div class="panel-head">
          <span class="idx">01</span>
          <span class="grow">CHANGES · 变化</span>
          <label class="hint" for="model-watch-change-metric">
            指标变动按
          </label>
          <select id="model-watch-change-metric" class="pick" data-change-metric></select>
          <div class="seg" role="group" aria-label="比较范围">
            {ranges.map((days) => (
              <button type="button" data-days={days} aria-pressed={days === 7 ? 'true' : 'false'}>
                {days} 天
              </button>
            ))}
          </div>
        </div>
        <div data-changes></div>
      </section>

      <section class="panel frame cut-s" id="mw-ranking" data-section aria-label="排行">
        <div class="panel-head">
          <span class="idx">02</span>
          <span class="grow">RANKING · 排行</span>
          <div class="seg" role="group" aria-label="排行方式">
            {rankTabs.map((tab, i) => (
              <button type="button" data-tab={`rank:${tab.key}`} aria-pressed={i === 0 ? 'true' : 'false'}>
                {tab.label}
              </button>
            ))}
          </div>
          <label class="sr" for="model-watch-metric">
            排行依据
          </label>
          <select id="model-watch-metric" class="pick" data-metric data-show="rank:metric"></select>
        </div>
        <div data-pane="rank:metric" data-board></div>
        <div data-pane="rank:creator" data-creators hidden></div>
      </section>

      <section class="panel frame cut-s" id="mw-charts" data-section aria-label="图表">
        <div class="panel-head">
          <span class="idx">03</span>
          <span class="grow">CHARTS · 图表</span>
          <div class="seg wrap" role="group" aria-label="图表">
            {chartTabs.map((tab, i) => (
              <button type="button" data-tab={`chart:${tab.key}`} aria-pressed={i === 0 ? 'true' : 'false'}>
                {tab.label}
              </button>
            ))}
          </div>
          <label class="sr" for="model-watch-frontier-metric">
            前沿指标
          </label>
          <select
            id="model-watch-frontier-metric"
            class="pick"
            data-frontier-metric
            data-show="chart:frontier"
            hidden
          ></select>
          <label class="sr" for="model-watch-timeline-metric">
            时间线指标
          </label>
          <select
            id="model-watch-timeline-metric"
            class="pick"
            data-timeline-metric
            data-show="chart:timeline"
            hidden
          ></select>
        </div>
        <div data-charts>
          <div data-pane="chart:value" data-value></div>
          <div data-pane="chart:speed" data-speed hidden></div>
          <div data-pane="chart:frontier" data-frontier hidden></div>
          <div data-pane="chart:timeline" data-timeline hidden></div>
        </div>
      </section>

      <section class="panel frame cut-s" id="mw-arenas" data-section aria-label="媒体竞技场">
        <div class="panel-head">
          <span class="idx">04</span>
          <span class="grow">ARENAS · 媒体竞技场</span>
          <label class="sr" for="model-watch-category">
            分类
          </label>
          <select id="model-watch-category" class="pick" data-category></select>
        </div>
        <div class="seg wrap" role="group" aria-label="竞技场">
          {MEDIA_BOARDS.map((board, i) => (
            <button type="button" data-media={board} aria-pressed={i === 0 ? 'true' : 'false'}>
              {BOARD_LABELS[board]}
            </button>
          ))}
        </div>
        <div data-media-list></div>
      </section>

      <p class="source">
        Source:{' '}
        <a href="https://artificialanalysis.ai/" rel="noopener" target="_blank">
          Artificial Analysis (artificialanalysis.ai)
        </a>
        。Based on data from Artificial Analysis：本页的排名、汇总和图表由本站根据其免费 API 自动生成，不代表 Artificial
        Analysis 的观点，也未经其认可。
      </p>
    </div>
  </div>
</BaseLayout>

<script>
  import '@/scripts/model-watch';
</script>
