---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHead from '@/components/ui/PageHead.astro';
import { getPosts, groupBy } from '@/lib/posts';

const posts = await getPosts();
const groups = groupBy(posts, 'tags');
const max = Math.max(...groups.map((g) => g.posts.length));
---

<BaseLayout title="Tags">
  <PageHead
    label="TAGS · 标签"
    title="标签"
    meta={`${groups.length} TAGS · ${posts.length} DOCUMENTS`}
    mark={groups.length}
  />

  <div class="tag-grid">
    {groups.map((g, i) => (
      <a class="dir-row" data-reveal href={`/tags/${g.slug}/`}>
        <span class="no">T-{String(i + 1).padStart(2, '0')}</span>
        <span class="name">{g.name}</span>
        <span class="bar" style={`--w:${(g.posts.length / max) * 100}%`}></span>
        <span class="count">{g.posts.length}</span>
      </a>
    ))}
  </div>
</BaseLayout>
